---
layout: base.njk
title: Projects
section: projects
permalink: /projects/index.html
---
<div class="project-list">{% for project in projects %}<article class="project"><div class="project-copy"><h2><a href="{{ project.url }}">{{ project.name | escape }}</a></h2><p>{{ project.description }}</p><p class="project-role"><b>My role:</b> {{ project.role }}</p></div>{% if project.icon %}<a class="project-icon" href="{{ project.url }}" aria-label="Visit {{ project.name | escape }}"><img src="{{ project.icon | assetUrl }}" alt="" loading="lazy" width="100" height="100"></a>{% endif %}</article>{% endfor %}</div>
