<div class="search-tools" data-search-controls hidden><label for="post-search">Search notes</label><div class="search-field"><span aria-hidden="true">⌕</span><input id="post-search" type="search" placeholder="Search a topic, tool, or finding…" autocomplete="off" aria-controls="post-list"><button type="button" id="clear-search" hidden>Clear</button></div><p id="search-status" class="search-status" role="status" aria-live="polite"></p></div>
<div class="topics" aria-label="Browse blog topics"><a href="/blog/"{% if not selectedTopic %} aria-current="page"{% endif %}>All notes</a>{% for topic in collections.topics %}<a href="/blog/tags/{{ topic | slugify }}/"{% if selectedTopic == topic %} aria-current="page"{% endif %}>{{ topic }}</a>{% endfor %}</div>
<div id="post-list" class="post-list">{% for entry in collections.posts %}{% if not selectedTopic or selectedTopic in entry.data.topics %}<article class="post-preview" data-post data-search="{{ (entry.data.title + ' ' + entry.data.description + ' ' + entry.data.topics | join(' ') + ' ' + entry.templateContent | searchText) | escape }}"><div class="post-meta"><time datetime="{{ entry.date | isoDate }}">{{ entry.date | dateLabel }}</time><span>{{ entry.data.readingTime }}</span></div><h2><a href="{{ entry.url }}">{{ entry.data.title }} <span aria-hidden="true">↗</span></a></h2><p>{{ entry.data.description }}</p><div class="post-tags">{% for topic in entry.data.topics %}<a href="/blog/tags/{{ topic | slugify }}/">#{{ topic }}</a>{% endfor %}</div></article>{% endif %}{% endfor %}</div>
<p id="no-results" class="empty-state" hidden>No matching notes. Try a different word or clear the search.</p>
